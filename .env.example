DATABASE_URL=postgres://user:password@db.example.com:5432/bridge?sslmode=verify-full
# Use an explicit opt-out only for trusted local development.
# DATABASE_URL=postgres://bridge:bridge@localhost:5432/bridge?sslmode=disable
DATABASE_SCHEMA=public
# DATABASE_SSL_MODE=disable
# DATABASE_SSL_MODE=require
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Paths below must be paths inside the container, for example /run/certs/ca.pem.
# DATABASE_SSL_CA_PATH=/run/certs/ca.pem
# DATABASE_SSL_CERT_PATH=/run/certs/client-cert.pem
# DATABASE_SSL_KEY_PATH=/run/certs/client-key.pem

TELEGRAM_BOT_TOKEN=123456:telegram-token
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_MAX_ACTIVE_TOPICS=100
TELEGRAM_REACTION_USER_ID=123456789
# Required for Telegram -> VK deletion sync. Create at https://my.telegram.org/apps.
# Run `npm run telegram:login` to generate TELEGRAM_USER_SESSION.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION=

VK_ACCESS_TOKEN=vk-user-or-community-token
# Optional photo-upload token for the SAME user account. Messages still use VK_ACCESS_TOKEN.
# VK_PHOTO_ACCESS_TOKEN=vk-photo-user-token
VK_API_VERSION=5.199
# Optional: raise this when VK starts allocating sticker product IDs above 20000.
# VK_STICKER_PRODUCT_ID_MAX=25000
VK_LONG_POLL_VERSION=21
VK_LONG_POLL_WAIT_SECONDS=25

MEDIA_MAX_DOWNLOAD_BYTES=52428800
# Defaults to MEDIA_MAX_DOWNLOAD_BYTES. Lower it if animated stickers need a tighter memory budget.
# MEDIA_MAX_TGS_DECOMPRESSED_BYTES=52428800
# STICKER_MAPPING_PATH=sticker-mapping.json
POLL_RETRY_BASE_MS=1000
# Serialize VK API calls and keep them below three requests per second by default.
VK_API_MIN_INTERVAL_MS=350
# VK error 9 (Flood control) uses a separate, substantially slower cooldown.
VK_FLOOD_RETRY_BASE_MS=900000
VK_FLOOD_RETRY_MAX_MS=7200000
METADATA_REFRESH_MS=600000
# Identical Telegram log messages are summarized at most once per this window.
LOG_REPEAT_WINDOW_MS=300000
NETWORK_REQUEST_TIMEOUT_MS=30000
NETWORK_MEDIA_TIMEOUT_MS=120000
NETWORK_MAX_RETRIES=3
